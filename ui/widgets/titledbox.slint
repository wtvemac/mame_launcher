// By: Eric MacDonald (eMac)

import { 
	HorizontalBox,
	Palette
} from "std-widgets.slint";

export component TitledVerticalBox inherits VerticalLayout {
	in property<styled-text> title: @markdown("title");
	in property<length> title-spacing: 5px;
	in property<length> title-font-size: 14px;
	in property<brush> title-color: Palette.foreground;
	in property<length> box-indent: 5px;
	in property<length> box-spacing: 0px;

	vertical-stretch: 0;
	spacing: root.title-spacing;
	padding-bottom: 10px;

	StyledText {
		text: root.title;
		default-font-size: root.title-font-size;
		default-color: root.title-color;
	}
	VerticalLayout {
		vertical-stretch: 0;
		padding: 0px;
		padding-left: root.box-indent;
		spacing: root.box-spacing;

		@children
	}
}

export component TitledHorizontalBox inherits VerticalLayout {
	in property<styled-text> title: @markdown("title");
	in property<length> title-spacing: 5px;
	in property<length> title-font-size: 14px;
	in property<int> title-font-weight: 700;
	in property<brush> title-color: Palette.foreground;
	in property<length> box-indent: 5px;
	in property<length> box-spacing: 0px;

	vertical-stretch: 0;
	spacing: root.title-spacing;
	padding-bottom: 10px;

	StyledText {
		text: @markdown("\{root.title}");
		default-font-size: root.title-font-size;
		default-color: root.title-color;
	}
	HorizontalBox {
		vertical-stretch: 0;
		padding: 0px;
		padding-left: root.box-indent;
		spacing: root.box-spacing;

		@children
	}
}
