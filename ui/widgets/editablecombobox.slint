// By: Eric MacDonald (eMac)

import { 
	Palette,
	LineEdit,
	ScrollView
} from "std-widgets.slint";

export struct HintedItem {
	hint: string,
	tooltip: string,
	value: string,
	icon: image,
	display_hint_only: bool // Only display the hint instead of "value: hint" (the value is still what's selected and edited).
}

export global ComboBoxWindow {
	in-out property <length> height: 0px;

	// This is enabled for a separate (borderless) window that can be drawn outside the main window. Useful for combobox's on small windows.
	in-out property <bool> external-popups-supported: false;
	callback show-external-popup(length, length, length, length, length, length, [HintedItem], string, bool, bool);
	in-out property <int> external-popup-serial: 0;
	in-out property <int> external-popup-selected-index: -1;
	callback close-external-popup();
	callback close-external-popup-if-unfocused();
}

global TooltipState {
	property <string> text: "";
	property <bool> visible: false;
	property <Point> position;
}

export component EditableComboBox inherits Rectangle {
	in property <bool> enabled: true;
	in property <bool> editable: false;
	in property <[string]> model: [];
	in property <[HintedItem]> hintedmodel: [];
	in property <string> placeholder-text: "";
	in property <bool> use-border-style: false;
	in property <bool> hint-before: false;
	in property <bool> display-hint-only: false;
	in property <bool> use-external-popup: false;
	
	property <bool> i-ishinted: (hintedmodel.length > 0);
	property <int> i-index: 0;
	property <string> i-value: "";
	property <string> i-hint: "";
	property <bool> i-changed: (i-value != current-value || i-hint != current-hint || i-hint != current-hint || ((hintedmodel.length > i-index) ? i-hint != hintedmodel[i-index].hint: false));

	in-out property <string> current-value: (i-ishinted) ? hintedmodel[i-index].value : ((model.length > 0) ? model[i-index] : "");

	out property <string> current-hint: (i-ishinted) ? hintedmodel[i-index].hint : "";
	out property <string> current-tooltip: (hintedmodel.length > 0) ? hintedmodel[i-index].tooltip : "";
	out property <image> current-icon: (i-ishinted) ? hintedmodel[i-index].icon : @image-url("");
	out property <int> item-count: ((i-ishinted) ? hintedmodel.length : model.length);

	property <bool> i-current-hint-only: (current-hint != "" && i-value == current-value && (display-hint-only || (i-ishinted && hintedmodel.length > i-index && hintedmodel[i-index].display_hint_only)));

	property <length> popup-item-height-adjust: 6px;

	property <bool> i-use-external-popup: (root.use-external-popup && root.i-ishinted && ComboBoxWindow.external-popups-supported);
	property <bool> i-external-popup-requested: false;
	property <int> i-external-popup-serial: ComboBoxWindow.external-popup-serial;
	changed i-external-popup-serial => {
		if (root.i-external-popup-requested) {
			root.i-external-popup-requested = false;
			if (ComboBoxWindow.external-popup-selected-index >= 0 && ComboBoxWindow.external-popup-selected-index < root.hintedmodel.length) {
				root.select-hinted-index(ComboBoxWindow.external-popup-selected-index);
			}
		}
	}

	function select-hinted-index(index: int) {
		root.i-index = index;
		root.current-value = root.hintedmodel[index].value;
		root.current-hint = root.hintedmodel[index].hint;
		root.current-tooltip = root.hintedmodel[index].tooltip;
		root.current-icon = root.hintedmodel[index].icon;

		// Don't focus hint-only items so the hint stays displayed instead of the full value.
		if(root.editable && !(root.hintedmodel[index].hint != "" && (root.display-hint-only || root.hintedmodel[index].display_hint_only))) {
			editbox.focus();
			editbox.clear-selection();
			editbox.set-selection-offsets(500, 500);
		}

		root.selection-changed();
	}

	// The popup opens below the combobox unless there's more room above. Either way it's limited to the space available in the window
	property <length> i-popup-margin: 4px;
	property <length> i-popup-full-height: (root.height - root.popup-item-height-adjust) * ((root.item-count > 10) ? 10 : root.item-count);
	property <length> i-popup-space-below: (ComboBoxWindow.height > 0px) ? (ComboBoxWindow.height - (root.absolute-position.y + root.height) - root.i-popup-margin) : root.i-popup-full-height;
	property <length> i-popup-space-above: root.absolute-position.y - root.i-popup-margin;
	property <bool> i-popup-above: (root.i-popup-space-below < root.i-popup-full-height && root.i-popup-space-above > root.i-popup-space-below);
	property <length> i-popup-height: max(root.height - root.popup-item-height-adjust, min(root.i-popup-full-height, (root.i-popup-above) ? root.i-popup-space-above : root.i-popup-space-below));

	callback selection-changed;
	callback close-popup-window;

	z: 1;

	// These rectangles are hacks to capture change events so we can sync up values.
	if i-changed: Rectangle {
		if i-ishinted: Rectangle {
			for value[index] in root.hintedmodel: Rectangle {
				init => {
					if value.value == current-value {
						root.i-index = index;
						root.i-value = value.value;
						root.i-hint = value.hint;

						root.current-hint = value.hint;
						root.current-tooltip = value.tooltip;
						root.current-icon = value.icon;
					}
				}
			}
		}
		if !i-ishinted: Rectangle {
			for value[index] in root.model: Rectangle {
				init => {
					if value == current-value {
						root.i-index = index;
						root.i-value = value;
						root.i-hint = "";

						root.current-hint = "";
						root.current-tooltip = "";
						root.current-icon = @image-url("");
					}
				}
			}
		}
	}

	height: 38px;
	min-width: 150px;
	horizontal-stretch: 1;
	border-radius: 5px;
	background: Palette.alternate-background;
	opacity: popopen-area.has-hover || editbox.has-focus ? 1.00 : 0.70;

	close-popup-window => {
		popup.close();
	}
	if root.current-icon.width != 0: icon := Image {
		source: root.current-icon;
		y: ((parent.height - self.height) / 2);
		x: 5px;
		width: 24px;
		height: (!root.editable) ? 24px : 0px;
		image-fit: contain;
	}
	nonedit-label := Text {
		text: (root.current-value == "") ? "" : (root.i-current-hint-only) ? root.current-hint : ((root.hint-before) ? (((root.current-hint != "") ? current-hint + ": " : "") + root.current-value) : (root.current-value + ((root.current-hint != "") ? ": " + current-hint : "")));
		x: (root.current-icon.width == 0) ? 10px : 35px;
		width: parent.width - self.x - 2px;
		height: (!root.editable) ? (parent.height) : 0px;
		visible: !root.editable;
		vertical-alignment: center;
		horizontal-alignment: left;
		font-size: 14px;
		color: Palette.foreground;
		overflow: elide;
		wrap: no-wrap;
	}
	editbox := LineEdit {
		text <=> root.current-value;
		x: 1px;
		y: ((parent.height - self.height) / 2);
		width: (parent.width - down-arrow.width - self.x) + ((down-arrow.width > 0) ? -8px : -1px);
		height: (root.editable) ? (parent.height - 2px) : 0px;
		visible: root.editable;
		enabled: (root.enabled);
		horizontal-alignment: left;
		font-size: nonedit-label.font-size;
		placeholder-text: root.placeholder-text;
	}
	editbox-border := Rectangle {
		x: editbox.x;
		y: editbox.y;
		width: editbox.width + 1px;
		height: (root.editable) ? (editbox.height + 1px): 0px;
		border-width: 4px;
		border-color: (use-border-style) ? Palette.alternate-background : transparent;
		background: transparent;
	}
	if root.editable && root.i-current-hint-only && !editbox.has-focus: Rectangle {
		x: editbox.x + 1px;
		y: editbox.y + 1px;
		width: editbox.width - 2px;
		height: editbox.height - 3px;
		border-radius: 4px;
		background: root.background;
		Rectangle {
			border-radius: parent.border-radius;
			background: Palette.control-background;
		}
		Text {
			text: root.current-hint;
			x: 11px;
			width: parent.width - self.x - 2px;
			height: parent.height;
			vertical-alignment: center;
			horizontal-alignment: left;
			font-size: nonedit-label.font-size;
			color: (root.enabled) ? Palette.foreground : Palette.foreground.transparentize(50%);
			overflow: elide;
			wrap: no-wrap;
		}
		TouchArea {
			enabled: root.enabled;
			clicked => {
				editbox.focus();
			}
		}
	}
	down-arrow := Image {
		source: @image-url("images/chevron-down.svg");
		x: (parent.width - self.width - 4px);
		y: (parent.height - self.height) / 2;
		width: (root.enabled && (model.length > 1 || hintedmodel.length > 1 || (hintedmodel.length == 1 && root.current-value != hintedmodel[0].value) || (model.length == 1 && root.current-value != model[0]))) ? self.height : 0px;
		height: 40%;
		colorize: Palette.foreground;
		image-fit: contain;
	}
	// EMAC: add up/down/enter keypress events for accessability?
	popopen-area := TouchArea {
		x: (root.editable) ? (editbox.x + editbox.width) : 0px;
		width: (root.editable) ? (down-arrow.width + 10px) : parent.width;
		height: 100%;
		enabled: root.current-value != "" && ((root.enabled && (model.length > 1 || hintedmodel.length > 1 || (hintedmodel.length == 1 && root.current-value != hintedmodel[0].value) || (model.length == 1 && root.current-value != model[0]))) || root.current-tooltip != "");


		clicked => {
			if (root.enabled && (model.length > 1 || hintedmodel.length > 1 || (hintedmodel.length == 1 && root.current-value != hintedmodel[0].value) || (model.length == 1 && root.current-value != model[0]))) {
				if (root.i-use-external-popup) {
					root.i-external-popup-requested = true;
					ComboBoxWindow.show-external-popup(
						root.absolute-position.x,
						root.absolute-position.y,
						root.absolute-position.y + root.height,
						root.width,
						root.i-popup-full-height,
						root.height - root.popup-item-height-adjust,
						root.hintedmodel,
						root.current-value,
						root.hint-before,
						root.display-hint-only
					);
				} else {
					popup.show();
				}
			}
		}

		tooltip := Rectangle { 
			states [ 
				visible when self.visible: {
					opacity: 0.8; 
					in {
						animate opacity {
							duration: 275ms;
							delay: 700ms;
						}
					}
				}
			]
			x: parent.mouse-x;
			y: parent.mouse-y - self.height;
			z: 1;
			width: tooltip-layout.preferred-width;
			height: tooltip-layout.preferred-height;
			visible: parent.has-hover && root.current-tooltip != "";
			opacity: 0.0;
			background: #000;
			border-width: 1px;
			border-radius: 4px;
			border-color: #444;
	
			tooltip-layout := HorizontalLayout { 
				z: 1;
				padding: 6px;
				Text { 
					z: 1;
					text: root.current-tooltip;
				}
			}
		}
	}
	
	// Dropdown menu
	// EMAC: look at issue where close-on-click messes with the scroll event. Need to use scroll wheel to scroll OR need to disable closing when you click outside. 
	// https://github.com/slint-ui/slint/issues/4209
	popup := PopupWindow {
		x: 0px;
		y: (root.i-popup-above) ? -root.i-popup-height : root.height;
		width: root.width;
		height: root.i-popup-height;
		close-policy: close-on-click-outside;

		Rectangle {
			background: Palette.alternate-background;
			border-width: 2px;
			border-radius: 3px;
			border-color: Palette.background;
		}
		
		// EMAC: add a scroll-to if selected item is out of view?
		scroll-box := ScrollView {
			width: parent.width;
			height: parent.height;
			content-width: parent.width;
			content-height: (root.height - root.popup-item-height-adjust) * root.item-count;

			if i-ishinted: VerticalLayout {
				spacing: 0px;
				for value[index] in root.hintedmodel: Rectangle {
					height: (root.height - root.popup-item-height-adjust);
					background: (itemsel-area.has-hover) ? Palette.foreground : Palette.alternate-background;
					border-width: 2px;
					border-color: (itemsel-area.has-hover) ? Palette.foreground : ((root.current-value == value.value) ? Palette.accent-background : Palette.alternate-background);
					HorizontalLayout {
						padding: 6px;
						spacing: 5px;
						if value.icon.width != 0: Image {
							source: value.icon;
							y: ((parent.height - self.height) / 2);
							width: 24px;
							height: 24px;
							image-fit: contain;
						}
						Text {
							text: (value.hint != "" && (root.display-hint-only || value.display_hint_only)) ? value.hint : (root.hint-before) ? (((value.hint!= "") ? value.hint + ": " : "") + value.value) : (value.value + ((value.hint!= "") ? ": " + value.hint : ""));
							color: (itemsel-area.has-hover) ? Palette.alternate-background : Palette.foreground;
							font-size: nonedit-label.font-size;
							vertical-alignment: center;
						}
					}
					itemsel-area := TouchArea {
						clicked => {
							root.select-hinted-index(index);

							popup.close();
						}
					}
				}
			}
			if !i-ishinted: VerticalLayout {
				spacing: 0px;
				for value[index] in root.model: Rectangle {
					height: root.height - 6px;
					background: (itemsel-area-hinted.has-hover) ? Palette.foreground : Palette.alternate-background;
					border-width: 2px;
					border-color: (itemsel-area-hinted.has-hover) ? Palette.foreground : ((root.current-value == value) ? Palette.accent-background : Palette.alternate-background);
					HorizontalLayout {
						Text {
							text: value;
							color: (itemsel-area-hinted.has-hover) ? Palette.alternate-background : Palette.foreground;
							font-size: nonedit-label.font-size;
							vertical-alignment: center;
						}
					}
					itemsel-area-hinted := TouchArea {
						clicked => {
							root.i-index = index;
							root.current-value = value;
							root.current-hint = "";
							root.current-tooltip = "";
							root.current-icon = @image-url("");

							if(root.editable) {
								editbox.focus();
								editbox.clear-selection();
								editbox.set-selection-offsets(500, 500);
							}

							root.selection-changed();

							popup.close();
						}
					}
				}
			}
		}
	}
}