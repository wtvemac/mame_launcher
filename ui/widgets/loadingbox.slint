import { 
	Spinner
} from "std-widgets.slint";

export component LoadingBox inherits Rectangle {
	x: 0px;
	y: 0px;
	width: 100%;
	height: 100%;
	background: black;
	opacity: 0.85;
	visible: true;
	// The spinner shrinks so the spinner and message fit in the box
	in property<length> size: max(root.min-size, min(root.width * 0.25, root.height - (root.edge-padding * 2) - root.message-spacing - root.message-height));
	in property<length> min-size: 24px;
	in property<length> edge-padding: 15px;
	in property<length> message-height: 32px;
	in property<percent> progress: 50%;
	in property<bool> indeterminate: true;
	in property<string> message: "";
	in property<length> message-spacing: 7px;
	in property<length> message-font-size: 16px;
	in property<float> message-font-weight: 800;
	in property<brush> message-color: white;
	

	// The spinner and message are centered together.
	property<length> group-height: root.size + root.message-spacing + root.message-height;

	loading-spinner := Spinner {
		x: (root.width - self.width) / 2;
		y: max(root.edge-padding, (root.height - root.group-height) / 2);
		width: root.size;
		height: root.size;
		opacity: 1.0;
		progress: root.progress;
		indeterminate: root.indeterminate;
	}

	Text {
		x: 0px;
		y: loading-spinner.y + loading-spinner.height + root.message-spacing;
		width: 100%;
		height: root.message-height;
		text: root.message;
		horizontal-alignment: center;
		vertical-alignment: center;
		opacity: 1.0;
		font-weight: root.message-font-weight;
		font-size: message-font-size;
		color: root.message-color;
	}

	TouchArea {
		x: 0px;
		y: 0px;
		width: 100%;
		height: 100%;
		enabled: root.visible;
	}
}
